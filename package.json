    "check": "node --check src/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "hono": "4.13.3",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
