{
  "name": "outcharity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
