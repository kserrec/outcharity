{
  "name": "outcharity",
  "version": "0.1.0",
  "description": "A Cloudflare Workers advertising leaderboard ranked by confirmed charitable contributions.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kserrec/outcharity.git"
  },
  "homepage": "https://outcharity.com",
  "bugs": {
    "url": "https://github.com/kserrec/outcharity/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "build": "wrangler deploy --dry-run --outdir dist --env-file /dev/null",
    "check": "node --check src/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "hono": "4.13.3",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
